VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_WORDOFLIFE_API_URL=

# Firebase AI Logic (Gemini via proxy do Firebase)
# Ative em: Firebase console > AI Services > AI Logic (escolha a Gemini Developer API)
# Chave do site ReCaptcha v3 para o App Check (crie em: Security > App Check > Apps)
VITE_RECAPTCHA_SITE_KEY=
# Ativa o debug token do App Check no desenvolvimento local (safetlistar no console)
VITE_APPCHECK_DEBUG=false
# Modelo Gemini usado (padrão: gemini-2.5-flash)
VITE_GEMINI_MODEL=gemini-2.5-flash
